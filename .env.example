# Порт и интерфейс
PORT=8080
# Локально: 127.0.0.1. На VPS за nginx: 127.0.0.1 (waitress) или 0.0.0.0 (только с firewall)
BIND_HOST=127.0.0.1

# Вариант 1: webhook (CRM, Telegram-бот, Zapier и т.п.)
# CALLBACK_WEBHOOK_URL=https://example.com/hooks/callback

# Вариант 2: email
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_TLS=1
# SMTP_USER=denmsr90@yandex.ru
# SMTP_PASSWORD=********
# SMTP_FROM=denmsr90@yandex.ru
# CALLBACK_EMAIL_TO=denmsr90@yandex.ru

# Без CALLBACK_WEBHOOK_URL и SMTP заявки НЕ считаются отправленными
# (пользователь увидит явную ошибку и телефон для связи).
